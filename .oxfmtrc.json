{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "printWidth": 100,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/assets/css/main.css",
    "attributes": [
      "ui",
      "active-class",
      "inactive-class",
      "enter-active-class",
      "enter-from-class",
      "leave-active-class",
      "leave-to-class"
    ]
  },
  "ignorePatterns": [
    "src-tauri/",
    "resources/",
    "temp/",
    "src/route-map.d.ts",
    "pnpm-lock.yaml",
    "auto-imports.d.ts",
    "components.d.ts",
    "src/shared/types/generated/"
  ]
}
