{
  "name": "oea",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc -p ./tsconfig.app.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "run-p typecheck lint format:check i18n:check",
    "fix": "run-s typecheck lint:fix i18n:fix format",
    "hooks:install": "lefthook install",
    "hooks:validate": "lefthook validate",
    "hooks:pre-commit": "lefthook run pre-commit --all-files",
    "submodules:init": "git submodule update --init --recursive",
    "tauri": "tauri",
    "makedata": "jiti scripts/makeAllData.ts",
    "download:models": "jiti scripts/downloadModels.ts",
    "package": "tauri build --no-bundle && jiti scripts/package.ts",
    "bump:version": "jiti scripts/bumpVersion.ts",
    "r2:publish": "jiti scripts/publishR2.ts publish",
    "r2:promote": "jiti scripts/publishR2.ts promote",
    "test:r2-release": "vitest run scripts/publishR2Core.test.ts",
    "generate:types": "cargo test --manifest-path src-tauri/Cargo.toml --lib export_bindings",
    "i18n:check": "jiti scripts/checks/i18n.ts",
    "i18n:fix": "jiti scripts/checks/i18n.ts --fix"
  },
  "dependencies": {
    "@nuxt/ui": "^4.10.0",
    "@tanstack/vue-virtual": "^3.13.39",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "~2.5.4",
    "@unhead/vue": "^2.1.16",
    "@vueuse/core": "^14.4.0",
    "dompurify": "^3.4.13",
    "fflate": "^0.8.3",
    "i18next": "^26.4.2",
    "i18next-vue": "^5.4.0",
    "marked": "^18.0.9",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/lib-storage": "^3.1121.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.2",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.7.0",
    "lefthook": "^2.1.12",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.71.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.9",
    "yazl": "^3.3.1"
  },
  "packageManager": "pnpm@12.8.1"
}
