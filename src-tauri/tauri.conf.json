{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OEA",
  "version": "0.1.0",
  "identifier": "com.logical-byte.oea",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm download:models && pnpm dev",
    "beforeBuildCommand": "pnpm download:models && pnpm build"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "../resources/icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
